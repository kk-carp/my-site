---
import { Icon } from 'astro-icon/components';
interface Props { id?: string; title: string; subtitle: string; note?: string; href: string; label: string }
const { id, title, subtitle, note, href, label } = Astro.props;
---
<div class="section-heading mb-6 flex items-center justify-between gap-4 border-l-4 border-primary pl-4">
  <div><div class="heading-title"><h2 id={id} class="font-display text-[26px] font-bold text-primary">{title}</h2>{note && <span class="heading-note">{note}</span>}</div><p class="mt-1 text-xs text-muted">{subtitle}</p></div>
  <a class="primary-link inline-flex shrink-0 items-center gap-1 rounded-md bg-primary px-3 py-2 text-xs font-semibold text-page" href={href}>
    {label}<Icon name="lucide:arrow-up-right" aria-hidden="true" />
  </a>
</div>
