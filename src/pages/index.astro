---
import { Icon } from 'astro-icon/components';
import AutumnWindow from '../components/AutumnWindow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import { publishedPosts, publishedProjects } from '../lib/content';
const [posts, projects] = await Promise.all([publishedPosts(), publishedProjects()]);
---
<BaseLayout title="koili" active="home">
  <div class="home-page">
    <section class="introduction" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="hello">你好，很高兴在这里遇见你。</p>
        <h1 id="intro-title">koili<span aria-hidden="true">.</span></h1>
        <p class="intro-lead">写一点文字，<br />做一些有趣的东西。</p>
        <p class="intro-description">一个正在开发 AI 应用的程序员。<br />喜欢把复杂问题讲成人话，也喜欢在路上发现新鲜事。</p>
        <div class="intro-actions">
          <a class="read-button" href="/blog/">读我的博客 <Icon name="lucide:arrow-right" aria-hidden="true" /></a>
          <a class="projects-link" href="/projects/">探索项目</a>
        </div>
      </div>
    <div class="portrait-scene">
      <svg class="orbit-drawing" viewBox="0 0 400 400" fill="none" aria-hidden="true">
        <defs><pattern id="home-grid" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" /></pattern></defs>
        <rect x="24" y="24" width="352" height="352" fill="url(#home-grid)" class="scene-grid" />
        <circle cx="200" cy="200" r="165" class="orbit-outer" />
        <ellipse cx="200" cy="200" rx="185" ry="94" transform="rotate(-35 200 200)" />
        <path d="M200 18v20m0 324v20M18 200h20m324 0h20M47 47h20v20m266 266v20h20" />
        <circle cx="75" cy="113" r="6" class="orbit-node" /><circle cx="342" cy="283" r="5" class="orbit-node" />
        <path d="m312 65 8-14 8 14Z" class="orbit-triangle" />
      </svg>
      <span class="scene-label scene-label-top"><Icon name="lucide:code-2" aria-hidden="true" /> 用代码实现想法</span>
      <div class="portrait"><AutumnWindow /><p>把想法，慢慢做成日常。</p></div>
      <span class="scene-label scene-label-bottom"><span class="status-dot" aria-hidden="true"></span> 保持探索中</span>
    </div>
    </section>

    <div class="interest-strip" aria-label="兴趣与关注">
      <p>保持好奇，持续创造。</p>
      <div><span><Icon name="lucide:code-2" aria-hidden="true" />AI 应用</span><span><Icon name="lucide:pen-line" aria-hidden="true" />写作</span><span><Icon name="lucide:compass" aria-hidden="true" />旅行</span></div>
    </div>

    <section class="writing-section" aria-labelledby="writing-title">
      <div class="section-intro">
        <h2 id="writing-title">最近在写</h2>
        <p>关于技术，也关于生活。<br />把想清楚的事，写得明白一点。</p>
        <a class="section-link" href="/blog/">全部文章 <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>
        <span class="sample-note">当前为示例文章</span>
      </div>
      <div class="post-list">{posts.slice(0, 3).map(post => <PostRow post={post} />)}</div>
    </section>

    <section class="projects-section" aria-labelledby="projects-title">
      <header class="projects-heading">
        <div><h2 id="projects-title">从想法到作品</h2><p>关于创造、整理和记录的一些尝试。<span class="sample-inline">示例项目</span></p></div>
        <a class="section-link" href="/projects/">全部项目 <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>
      </header>
      <div class="project-grid">{projects.slice(0, 3).map(project => <ProjectCard project={project} />)}</div>
    </section>

    <aside class="home-closing"><Icon name="lucide:sprout" aria-hidden="true" /><p>不着急，好的想法会慢慢长出来。</p><span>继续探索，也记得生活。</span></aside>
  </div>
</BaseLayout>

<style>
  .home-page { --tech: #527b78; --tech-line: color-mix(in srgb, var(--tech) 28%, transparent); --soft-text: color-mix(in srgb, var(--text) 78%, var(--bg)); }
  .introduction { display: grid; grid-template-columns: 1.3fr 1fr; gap: 64px; align-items: center; padding: 76px 0 60px; }
  .hello { font-size: 13px; color: var(--soft-text); margin-bottom: 12px; }
  h1 { font-family: 'Trebuchet MS', 'Arial', sans-serif; font-size: clamp(86px, 10vw, 136px); font-weight: 700; line-height: 1; letter-spacing: -.075em; margin-left: -6px; margin-bottom: 28px; }
  h1 span { color: var(--primary); }
  .intro-lead { font-size: clamp(23px, 2.6vw, 31px); font-weight: 600; line-height: 1.65; letter-spacing: .04em; margin-bottom: 20px; }
  .intro-description { font-size: 14px; line-height: 2; color: var(--soft-text); max-width: 33em; }
  .intro-actions { display: flex; align-items: center; gap: 28px; margin-top: 30px; font-size: 13px; }
  .read-button { display: inline-flex; align-items: center; gap: 22px; border-radius: 24px; padding: 12px 22px; background: var(--primary); color: var(--bg); }
  .read-button:hover { background: var(--text); color: var(--bg); }
  .read-button [data-icon] { width: 16px; height: 16px; }
  .projects-link { text-decoration: underline; text-underline-offset: 6px; }
  .portrait-scene { position: relative; display: grid; place-items: center; min-height: 390px; }
  .orbit-drawing { position: absolute; width: 112%; max-width: 420px; height: auto; stroke: var(--tech-line); stroke-width: 1; pointer-events: none; }
  .scene-grid { stroke-opacity: .32; }
  .orbit-outer { stroke-dasharray: 3 8; }
  .orbit-node { fill: var(--tech); stroke: var(--bg); stroke-width: 4; }
  .orbit-triangle { stroke: var(--primary); }
  .portrait { position: relative; z-index: 1; gap: 16px; }
  .portrait p { font-size: 12px; letter-spacing: 2px; }
  .scene-label { position: absolute; z-index: 2; display: flex; align-items: center; gap: 8px; background: var(--bg); border: 1px solid var(--tech-line); padding: 7px 11px; border-radius: 4px; color: var(--tech); font-size: 11px; box-shadow: 0 4px 14px color-mix(in srgb, var(--text) 4%, transparent); }
  .scene-label [data-icon] { width: 14px; height: 14px; }
  .scene-label-top { right: -4px; top: 42px; transform: rotate(5deg); }
  .scene-label-bottom { left: 0; bottom: 44px; transform: rotate(-4deg); }
  .scene-label .status-dot { background: var(--tech); }
  :global([data-theme="dark"]) .home-page { --tech: #8bb9b2; }
  .interest-strip { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 23px 0; border-block: 1px solid var(--line); font-size: 13px; color: var(--soft-text); }
  .interest-strip > div { display: flex; gap: 32px; }
  .interest-strip span { display: inline-flex; gap: 9px; align-items: center; }
  .interest-strip [data-icon] { width: 16px; height: 16px; color: var(--primary); }
  .writing-section { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 48px; padding: 68px 0; }
  h2 { font-size: 27px; line-height: 1.5; letter-spacing: .02em; }
  .section-intro > p { font-size: 13px; color: var(--soft-text); line-height: 1.9; margin: 14px 0 24px; }
  .section-link { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--primary); }
  .section-link [data-icon] { width: 15px; height: 15px; }
  .sample-note { display: block; font-size: 11px; color: var(--soft-text); margin-top: 18px; }
  .post-list :global(.blog-row) { grid-template-columns: minmax(0, 1fr) 20px; padding: 24px 0; gap: 7px 24px; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; background: transparent; }
  .post-list :global(.blog-row:first-child) { padding-top: 0; }
  .post-list :global(.blog-row:last-child) { border-bottom: 0; padding-bottom: 0; }
  .post-list :global(.blog-row:hover h3) { color: var(--primary); }
  .post-list :global(.blog-row time), .post-list :global(.blog-row > div) { grid-column: 1; }
  .post-list :global(.row-arrow) { grid-column: 2; grid-row: 2; }
  .post-list :global(.blog-row time) { font-size: 11px; color: var(--soft-text); margin: 0 0 2px; }
  .post-list :global(h3) { font-size: 19px; line-height: 1.6; margin-bottom: 7px; }
  .post-list :global(.blog-row p) { font-size: 13px; color: var(--soft-text); }
  .projects-section { padding: 42px 34px 34px; background: var(--surface); border-radius: 14px; }
  .projects-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
  .projects-heading p { font-size: 13px; color: var(--soft-text); margin-top: 10px; }
  .sample-inline { display: inline-block; font-size: 10px; margin-left: 10px; padding: 1px 6px; border: 1px solid var(--line); border-radius: 4px; }
  .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; }
  .project-grid :global(.project-card) { background: transparent; border: 0; border-radius: 0; padding: 0; }
  .project-grid :global(.project-cover) { height: 162px; border: 1px solid var(--line); border-radius: 9px; }
  .project-grid :global(.project-cover [data-icon]) { width: 70px; height: 70px; stroke-width: 1; }
  .project-grid :global(.project-card:nth-child(2) .project-cover) { background: color-mix(in srgb, var(--olive) 7%, var(--bg)); }
  .project-grid :global(.project-card:nth-child(3) .project-cover) { background: color-mix(in srgb, var(--accent) 14%, var(--bg)); }
  .project-grid :global(.project-card h3) { font-size: 18px; }
  .project-grid :global(.project-card p) { font-size: 12px; color: var(--soft-text); }
  .project-grid :global(.tag) { padding: 2px 6px; font-size: 10px; background: transparent; color: var(--soft-text); }
  .home-closing { padding: 54px 0; text-align: center; }
  .home-closing [data-icon] { width: 24px; height: 24px; margin: 0 auto 14px; color: var(--olive); }
  .home-closing p { font-size: 17px; }
  .home-closing > span { display: block; color: var(--soft-text); font-size: 12px; margin-top: 7px; }
  @media (max-width: 900px) {
    .introduction { gap: 32px; padding-top: 54px; }
    .portrait-scene { min-height: 330px; }
    .scene-label { font-size: 10px; padding: 5px 8px; }
    .scene-label-top { top: 20px; }
    .scene-label-bottom { bottom: 24px; }
    .writing-section { grid-template-columns: 200px minmax(0, 1fr); gap: 28px; }
    .projects-section { padding: 28px 24px; }
    .project-grid { gap: 20px; }
  }
  @media (max-width: 640px) {
    .introduction { grid-template-columns: minmax(0, 1fr); gap: 35px; padding: 38px 0 30px; }
    h1 { font-size: 100px; margin-bottom: 20px; }
    .intro-lead { font-size: 25px; }
    .intro-description { font-size: 13px; }
    .portrait-scene { position: relative; display: grid; place-items: center; min-height: 390px; }
  .orbit-drawing { position: absolute; width: 112%; max-width: 420px; height: auto; stroke: var(--tech-line); stroke-width: 1; pointer-events: none; }
  .scene-grid { stroke-opacity: .32; }
  .orbit-outer { stroke-dasharray: 3 8; }
  .orbit-node { fill: var(--tech); stroke: var(--bg); stroke-width: 4; }
  .orbit-triangle { stroke: var(--primary); }
  .portrait { position: relative; z-index: 1; gap: 16px; }
  .portrait p { font-size: 12px; letter-spacing: 2px; }
  .scene-label { position: absolute; z-index: 2; display: flex; align-items: center; gap: 8px; background: var(--bg); border: 1px solid var(--tech-line); padding: 7px 11px; border-radius: 4px; color: var(--tech); font-size: 11px; box-shadow: 0 4px 14px color-mix(in srgb, var(--text) 4%, transparent); }
  .scene-label [data-icon] { width: 14px; height: 14px; }
  .scene-label-top { right: -4px; top: 42px; transform: rotate(5deg); }
  .scene-label-bottom { left: 0; bottom: 44px; transform: rotate(-4deg); }
  .scene-label .status-dot { background: var(--tech); }
  :global([data-theme="dark"]) .home-page { --tech: #8bb9b2; }
  .interest-strip { align-items: flex-start; flex-direction: column; gap: 12px; padding-block: 20px; }
    .interest-strip > div { gap: 25px; }
    .writing-section { grid-template-columns: minmax(0, 1fr); gap: 26px; padding-block: 38px; }
    .section-intro { position: relative; }
    .section-intro > p { margin: 10px 0 0; }
    .section-intro .section-link { position: absolute; right: 0; top: 12px; }
    .sample-note { margin-top: 10px; }
    h2 { font-size: 24px; }
    .post-list :global(h3) { font-size: 18px; }
    .projects-heading { align-items: flex-start; flex-direction: column; gap: 14px; }
    .project-grid { grid-template-columns: minmax(0, 1fr); gap: 30px; }
    .project-grid :global(.project-cover) { height: 190px; }
    .projects-section { padding: 25px 20px; }
    .home-closing { padding-block: 36px; }
    .home-closing p { font-size: 15px; }
  }
</style>
