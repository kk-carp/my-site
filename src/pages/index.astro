---
import { Icon } from 'astro-icon/components';
import AutumnWindow from '../components/AutumnWindow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { publishedPosts, publishedProjects } from '../lib/content';
const [posts, projects] = await Promise.all([publishedPosts(), publishedProjects()]);
---
<BaseLayout title="首页" active="home">
 <div class="home-page">
  <div class="home-intro">
  <section class="hero" aria-labelledby="intro-title">
    <div class="hero-copy min-w-0">
      <p class="intro-note"><span class="status-dot" aria-hidden="true"></span>在这里，记录一些正在发生的事</p>
      <h1 id="intro-title"><span>你好，</span><span>我是林安。</span></h1>
      <p class="lead">一个正在开发AI应用的程序员</p>
      <p class="description">在这里写下 AI 应用的实践、思考和生活里的发现。<br />喜欢把复杂问题讲成人话，也把一些想法做成小项目。</p>
      <div class="flex flex-wrap gap-2" aria-label="兴趣">{['AI 应用', '写作', '旅行'].map(tag => <span class="tag">{tag}</span>)}</div>
      <div class="hero-actions">
        <a class="explore-button" href="/blog/">阅读博客 <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>
        <a class="writing-link" href="/projects/">看看我的项目 <Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      </div>
      <div class="contact-icons mt-7 flex gap-5 text-primary" aria-label="联系方式，链接待补充">
        <span role="img" aria-label="邮箱（待补充）" title="邮箱 · 待补充"><Icon name="lucide:mail" aria-hidden="true" /></span>
        <span role="img" aria-label="GitHub（待补充）" title="GitHub · 待补充"><Icon name="lucide:github" aria-hidden="true" /></span>
      </div>
    </div>
    <div class="portrait-scene">
      <svg class="orbit-drawing" viewBox="0 0 400 400" fill="none" aria-hidden="true">
        <defs><pattern id="home-grid" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" /></pattern></defs>
        <rect x="24" y="24" width="352" height="352" fill="url(#home-grid)" class="scene-grid" />
        <circle cx="200" cy="200" r="165" class="orbit-outer" />
        <ellipse cx="200" cy="200" rx="185" ry="94" transform="rotate(-35 200 200)" />
        <path d="M200 18v20m0 324v20M18 200h20m324 0h20M47 47h20v20m266 266v20h20" />
        <circle cx="75" cy="113" r="6" class="orbit-node" /><circle cx="342" cy="283" r="5" class="orbit-node" />
        <path d="m312 65 8-14 8 14Z" class="orbit-triangle" />
      </svg>
      <span class="scene-label scene-label-top"><Icon name="lucide:code-2" aria-hidden="true" /> 用代码实现想法</span>
      <div class="portrait"><AutumnWindow /><p>把想法，慢慢做成日常。</p></div>
      <span class="scene-label scene-label-bottom"><span class="status-dot" aria-hidden="true"></span> 保持探索中</span>
    </div>
  </section>
  </div>
  <div class="home-content">
  <section class="home-section writing-section reveal" aria-labelledby="writing-title">
    <SectionHeading id="writing-title" title="最新博客" subtitle="关于 AI、技术实践与日常思考，把想清楚的事写下来" note="示例文章" href="/blog/" label="全部博客" />
    <div class="writing-layout">
      <aside class="writing-note">
        <Icon name="lucide:quote" aria-hidden="true" />
        <p>做东西的时候，<br />也留一点时间思考。</p>
        <span>关于技术，也关于生活。<br />一些观察，一些还在生长的想法。</span>
        <div class="note-geometry" aria-hidden="true"><i></i><i></i><i></i></div>
      </aside>
      <div class="post-list grid gap-4">{posts.slice(0, 3).map(post => <PostRow post={post} />)}</div>
    </div>
  </section>
  <section class="home-section projects-section reveal" aria-labelledby="projects-title">
    <SectionHeading id="projects-title" title="项目与尝试" subtitle="把文章里的思考，落在具体的东西上" note="示例项目" href="/projects/" label="全部项目" />
    <div class="project-grid grid gap-6">{projects.slice(0, 3).map(project => <ProjectCard project={project} />)}</div>
  </section>
  </div>
  <aside class="closing reveal flex items-center justify-between gap-6 rounded-lg bg-primary text-page">
    <div class="closing-geometry" aria-hidden="true"><span></span><span></span></div>
    <p class="font-display text-lg font-bold">保持好奇，也保持自己的节奏。</p><span class="text-xs">关于 AI，关于生活，关于下一次出发。</span>
  </aside>
 </div>
</BaseLayout>

<style>
  .home-page { --tech: #527b78; --tech-line: color-mix(in srgb, var(--tech) 28%, transparent); --secondary-text: color-mix(in srgb, var(--text) 74%, var(--bg)); }
  :global([data-theme="dark"]) .home-page { --tech: #8bb9b2; }
  .hero { position: relative; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 12px; padding: 48px 44px 38px; margin-bottom: 0; overflow: hidden; border-top-width: 1px; background: linear-gradient(115deg, var(--surface) 55%, color-mix(in srgb, var(--tech) 7%, var(--surface))); }
  .hero::before { content: ''; position: absolute; left: 0; top: 45px; width: 4px; height: 84px; background: var(--primary); }
  .hero-copy { position: relative; z-index: 1; }
  .hero h1 { font-size: clamp(42px, 4.5vw, 60px); letter-spacing: 0; }
  .hero .lead { font-size: 21px; color: var(--text); }
  .hero .description { color: var(--secondary-text); font-size: 14px; line-height: 1.95; }
  .home-intro { padding-bottom: 36px; }
  .home-content { border-top: 2px solid var(--primary-line); padding-top: 44px; }
  .home-section { margin-bottom: 48px; }
  .projects-section { padding: 30px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
  .writing-section { padding: 0 0 10px; }
  .projects-section :global(.section-heading h2) { font-size: 26px; }
  .home-page :global(.section-heading) { align-items: center; margin-bottom: 26px; padding: 0 0 22px; border-left: 0; border-bottom: 1px solid var(--primary-line); }
  .home-page :global(.section-heading h2) { color: var(--text); font-size: 30px; line-height: 1.4; letter-spacing: .03em; }
  .home-page :global(.section-heading p) { margin-top: 8px; color: var(--secondary-text); font-size: 13px; line-height: 1.7; }
  .home-page :global(.heading-title) { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .home-page :global(.heading-note) { border: 1px solid var(--line); border-radius: 4px; padding: 2px 7px; color: var(--secondary-text); font-size: 10px; font-weight: 400; white-space: nowrap; }
  .home-page :global(.section-heading .primary-link) { color: var(--primary); background: var(--bg); border: 1px solid var(--primary-line); padding: 8px 12px; }
  .home-page :global(.section-heading .primary-link:hover) { color: var(--bg); background: var(--primary); }
  .home-page :global(.project-card) { background: var(--bg); padding: 14px; }
  .home-page :global(.project-card h3) { color: var(--text); font-size: 20px; line-height: 1.5; margin-top: 18px; margin-bottom: 9px; }
  .home-page :global(.project-card p) { font-size: 13px; color: var(--secondary-text); }
  .home-page :global(.project-card .tag) { color: var(--secondary-text); border-color: var(--line); font-size: 10px; }
  .home-page :global(.project-more) { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 14px; margin-top: 18px; }
  .home-page :global(.blog-row h3) { font-size: 20px; line-height: 1.6; margin-top: 5px; margin-bottom: 8px; color: var(--text); }
  .home-page :global(.blog-row p) { font-size: 13px; line-height: 1.8; color: var(--secondary-text); }
  .home-page :global(.blog-row time) { font-size: 11px; color: var(--secondary-text); }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 28px; font-size: 13px; }
  .hero-actions a { display: inline-flex; align-items: center; gap: 12px; }
  .explore-button { padding: 11px 18px; border-radius: 5px; color: var(--bg); background: var(--primary); }
  .explore-button:hover { background: var(--text); color: var(--bg); }
  .writing-link { color: var(--primary); }
  .hero-actions [data-icon] { width: 16px; height: 16px; }
  .portrait-scene { position: relative; display: grid; place-items: center; min-height: 390px; }
  .orbit-drawing { position: absolute; width: 112%; max-width: 420px; height: auto; stroke: var(--tech-line); stroke-width: 1; pointer-events: none; }
  .scene-grid { stroke-opacity: .32; }
  .orbit-outer { stroke-dasharray: 3 8; }
  .orbit-node { fill: var(--tech); stroke: var(--bg); stroke-width: 4; }
  .orbit-triangle { stroke: var(--primary); }
  .portrait { position: relative; z-index: 1; gap: 16px; }
  .portrait p { font-size: 12px; letter-spacing: 2px; }
  .scene-label { position: absolute; z-index: 2; display: flex; align-items: center; gap: 8px; background: var(--bg); border: 1px solid var(--tech-line); padding: 7px 11px; border-radius: 4px; color: var(--tech); font-size: 11px; box-shadow: 0 4px 14px color-mix(in srgb, var(--text) 4%, transparent); }
  .scene-label [data-icon] { width: 14px; height: 14px; }
  .scene-label-top { right: -4px; top: 42px; transform: rotate(5deg); }
  .scene-label-bottom { left: 0; bottom: 44px; transform: rotate(-4deg); }
  .scene-label .status-dot { background: var(--tech); }
  .home-page :global(.project-cover) { overflow: hidden; background-image: radial-gradient(var(--tech-line) .8px, transparent .8px); background-size: 15px 15px; }
  .home-page :global(.project-cover)::before, .home-page :global(.project-cover)::after { content: ''; position: absolute; width: 122px; height: 122px; border: 1px solid var(--tech-line); border-radius: 50%; pointer-events: none; }
  .home-page :global(.project-cover)::after { width: 150px; height: 150px; border-style: dashed; opacity: .65; }
  .home-page :global(.project-card:nth-child(2) .project-cover)::before { border-radius: 18px; transform: rotate(30deg); }
  .home-page :global(.project-card:nth-child(2) .project-cover)::after { border-radius: 18px; transform: rotate(-15deg); }
  .home-page :global(.project-card:nth-child(3) .project-cover)::before { width: 160px; height: 75px; transform: rotate(-30deg); }
  .home-page :global(.project-cover > [data-icon]) { position: relative; z-index: 1; width: 75px; height: 75px; background: var(--bg); padding: 8px; }
  .writing-layout { display: grid; grid-template-columns: .8fr 2fr; gap: 24px; }
  .writing-note { position: relative; overflow: hidden; padding: 26px; border-radius: 8px; border: 1px solid var(--tech-line); background: color-mix(in srgb, var(--tech) 6%, var(--bg)); }
  .writing-note > [data-icon] { color: var(--tech); width: 25px; height: 25px; margin-bottom: 15px; }
  .writing-note p { position: relative; z-index: 1; font: 600 21px/1.8 var(--font-display); margin-bottom: 14px; }
  .writing-note > span { position: relative; z-index: 1; font-size: 12px; color: var(--muted); }
  .note-geometry { position: absolute; right: -34px; bottom: -45px; width: 140px; height: 140px; }
  .note-geometry i { position: absolute; inset: 0; border: 1px solid var(--tech-line); transform: rotate(30deg); }
  .note-geometry i:nth-child(2) { inset: 15px; }
  .note-geometry i:nth-child(3) { inset: 30px; }
  .post-list { align-content: start; }
  .home-page :global(.blog-row) { grid-template-columns: minmax(0, 1fr) 20px; gap: 5px 16px; padding: 22px 24px; border-left-width: 1px; }
  .home-page :global(.blog-row time), .home-page :global(.blog-row > div) { grid-column: 1; }
  .home-page :global(.row-arrow) { grid-column: 2; grid-row: 2; }
  .closing { position: relative; overflow: hidden; padding-block: 35px; isolation: isolate; }
  .closing > p, .closing > span { position: relative; z-index: 1; }
  .closing-geometry { position: absolute; right: 20%; top: -80px; width: 260px; height: 260px; z-index: 0; opacity: .16; pointer-events: none; }
  .closing-geometry span { position: absolute; inset: 0; border: 1px solid currentColor; border-radius: 50%; }
  .closing-geometry span:last-child { inset: 25px; border-radius: 0; transform: rotate(35deg); }
  @media (max-width: 1000px) {
    .hero { padding-inline: 30px; }
    .scene-label-top { right: -12px; }
    .writing-layout { grid-template-columns: 1fr 2fr; gap: 16px; }
    .writing-note { padding: 22px; }
    .writing-note p { font-size: 18px; }
  }
  @media (max-width: 800px) {
    .projects-section { padding: 22px; }
    .home-page :global(.project-grid) { grid-template-columns: minmax(0, 1fr); }
    .home-page :global(.project-cover) { height: 200px; }
    .hero { grid-template-columns: minmax(0, 1fr) 230px; gap: 10px; }
    .hero h1 { font-size: 44px; }
    .hero .lead { font-size: 18px; }
    .portrait-scene { min-height: 330px; }
    .scene-label { font-size: 10px; padding: 5px 8px; }
    .scene-label-top { top: 20px; }
    .scene-label-bottom { bottom: 24px; }
    .writing-layout { grid-template-columns: 1fr; }
    .writing-note { display: none; }
  }
  @media (max-width: 560px) {
    .home-intro { padding-bottom: 28px; }
    .home-content { padding-top: 28px; }
    .home-section { margin-bottom: 32px; }
    .projects-section { padding: 20px 16px; border-radius: 9px; }
    .home-page :global(.section-heading) { align-items: flex-start; gap: 12px; padding-bottom: 18px; margin-bottom: 20px; }
    .home-page :global(.section-heading h2) { font-size: 25px; }
    .home-page :global(.heading-title) { gap: 8px; }
    .home-page :global(.section-heading p) { font-size: 12px; max-width: 18em; }
    .home-page :global(.section-heading .primary-link) { font-size: 11px; padding: 6px 8px; margin-top: 3px; }
    .home-page :global(.blog-row h3) { font-size: 18px; }
    .hero { display: flex; flex-direction: column; padding: 28px 22px 18px; margin-top: 22px; }
    .hero-copy { width: 100%; }
    .hero h1 { max-width: none; font-size: clamp(35px, 9vw, 48px); margin-bottom: 20px; }
    .hero .intro-note { max-width: none; }
    .hero-actions { gap: 20px; margin-top: 24px; }
    .hero :global(.contact-icons) { margin-top: 22px; }
    .portrait-scene { width: min(100%, 300px); min-height: 300px; margin-top: 8px; }
    .portrait { position: relative; top: auto; right: auto; }
    .portrait :global(.avatar-frame) { width: 148px; height: 170px; }
    .portrait p { display: block; font-size: 11px; }
    .scene-label-top { right: 0; top: 26px; }
    .scene-label-bottom { bottom: 32px; }
    .home-page :global(.blog-row) { padding: 18px; }
    .closing { padding: 26px 23px; }
    .closing-geometry { right: -100px; }
  }
</style>
